# PayHere MCP — environment variables
#
# Copy this file to .env for local development. Never commit .env.

# Mode: "sandbox" or "live"
PAYHERE_MODE=sandbox

# Merchant ID — found at Settings > Integrations in your PayHere dashboard
PAYHERE_MERCHANT_ID=YOUR_MERCHANT_ID

# Merchant Secret — specific to each whitelisted domain/app
PAYHERE_MERCHANT_SECRET=YOUR_MERCHANT_SECRET

# Business App credentials — Settings > Business Apps, create an app and copy the values
PAYHERE_APP_ID=YOUR_APP_ID
PAYHERE_APP_SECRET=YOUR_APP_SECRET
